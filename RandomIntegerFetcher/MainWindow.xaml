<Window
    x:Class="RandomIntegerFetcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Random Integer Fetcher"
>
    <Canvas Loaded="Window_Loaded">
        <TextBlock x:Name="label1" Canvas.Left="58" Canvas.Top="48"
                   FontFamily="Microsoft Sans Serif" FontSize="16" FontWeight="Bold"
                   Text="Get Random Integer from Random.org" />
        <Button x:Name="buttonGetRandom" Canvas.Left="58" Canvas.Top="78"
                Width="151" Height="58"
                FontFamily="Microsoft Sans Serif" FontSize="16" FontWeight="Bold"
                Content="2" Click="ButtonGetRandom_Click" />
        <Button x:Name="button1" Canvas.Left="217" Canvas.Top="78"
                Width="151" Height="58"
                FontFamily="Microsoft Sans Serif" FontSize="16" FontWeight="Bold"
                Content="3" Click="ButtonGetRandom_Click" />
        <TextBlock x:Name="labelRandomInteger" Canvas.Left="58" Canvas.Top="150"
                   FontFamily="Microsoft Sans Serif" FontSize="18.667" FontWeight="Bold"
                   Text="Random Integer: --" />
        <TextBlock x:Name="labelDateTime" Canvas.Left="58" Canvas.Top="196"
                   FontFamily="Microsoft Sans Serif" FontSize="16"
                   Text="Date &amp; Time: --" />
        <TextBlock x:Name="labelStatus" Canvas.Left="58" Canvas.Top="242"
                   FontFamily="Microsoft Sans Serif" FontSize="13.333"
                   Text="Ready." />
    </Canvas>
</Window>